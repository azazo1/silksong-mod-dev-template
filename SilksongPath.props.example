<Project>
  <!-- 复制成 SilksongPath.props 并按需改路径, 该文件不入版本库. -->
  <!-- 缺省指向仓库内的隔离子实例; 编完会复制到 BepInEx/plugins. -->
  <PropertyGroup>
    <SilksongFolder>game/Hollow Knight Silksong</SilksongFolder>
    <SilksongPluginsFolder>$(SilksongFolder)/BepInEx/plugins</SilksongPluginsFolder>
  </PropertyGroup>
</Project>
